<?xml version="1.0" encoding="utf-8"?>
<!--
  The envelope. Two things here are load-bearing and easy to get wrong:

  extractNativeLibs="true" makes Android unpack lib/[abi]/* onto the
  filesystem and marks it executable. Without it the VM stays inside the
  APK as a compressed entry and cannot be run as a process.

  The Ring VM ships as lib/[abi]/libring.so. It is an executable, not a
  shared library, and the .so name is not cosmetic: Android extracts and
  marks executable only files matching lib*.so.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.softanza.ringpp.demo"
    android:versionCode="1"
    android:versionName="0.9">

  <application
      android:label="Ring++ on Android"
      android:extractNativeLibs="true"
      android:allowBackup="false">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:label="Ring++ on Android">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

  </application>
</manifest>
